import 'package:dio/dio.dart';

import '../../../core/constants/api_constants.dart';
import '../../../core/network/api_result.dart';
import '../../../core/network/dio_client.dart';
import '../../../core/network/error_mapper_interceptor.dart';
import '../../../core/utils/storage_service.dart';
import '../model/user_model.dart';

/// No-password flow: request a code for an email/phone, verify it, and —
/// only if the account did not already exist — collect a display name to
/// finish account creation. Swap the endpoint paths in [ApiConstants] to
/// match your backend; the shape (`accountExists` on the request-OTP
/// response) is the one contract this flow depends on.
class AuthRepository {
  final Dio _dio = DioClient.instance.dio;

  /// Sends a verification code and reports whether [identifier] (email or
  /// phone) already has an account.
  Future<ApiResult<bool>> requestOtp({required String identifier}) async {
    try {
      final response = await _dio.post(
        ApiConstants.requestOtp,
        data: {'identifier': identifier},
      );
      return ApiResult<bool>.fromJson(
        response.data,
        fromData: (d) => d['accountExists'] == true,
      );
    } on DioException catch (e) {
      return ApiResult.failure(e.apiError, statusCode: e.response?.statusCode);
    }
  }

  /// Verifies the code. For an existing account this logs the user in
  /// directly (token + user returned). For a new account, `data` may be
  /// null — the screen should proceed to collect a name via
  /// [completeProfile] before treating the user as fully onboarded.
  Future<ApiResult<UserModel?>> verifyOtp({
    required String identifier,
    required String code,
  }) async {
    try {
      final response = await _dio.post(ApiConstants.verifyOtp, data: {
        'identifier': identifier,
        'code': code,
      });
      final result = ApiResult<UserModel?>.fromJson(
        response.data,
        fromData: (d) => d == null ? null : UserModel.fromJson(d),
      );
      final token = response.data['data']?['token']?.toString();
      if (result.success && token != null) {
        await StorageService.setToken(token);
      }
      return result;
    } on DioException catch (e) {
      return ApiResult.failure(e.apiError, statusCode: e.response?.statusCode);
    }
  }

  Future<ApiResult<UserModel>> completeProfile({
    required String identifier,
    required String name,
  }) async {
    try {
      final response = await _dio.post(ApiConstants.register, data: {
        'identifier': identifier,
        'name': name,
      });
      final result = ApiResult<UserModel>.fromJson(
        response.data,
        fromData: (d) => UserModel.fromJson(d),
      );
      final token = response.data['data']?['token']?.toString();
      if (result.success && token != null) {
        await StorageService.setToken(token);
      }
      return result;
    } on DioException catch (e) {
      return ApiResult.failure(e.apiError, statusCode: e.response?.statusCode);
    }
  }

  Future<void> logout() async {
    try {
      await _dio.post(ApiConstants.logout);
    } catch (_) {}
    await StorageService.clearAuth();
  }
}
